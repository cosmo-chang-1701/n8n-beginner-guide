# ==============================================================================
# n8n 2026 生產環境變數示範檔 (.env.example)
# 複製此檔為 .env 並填寫您組織的真實密鑰
# ==============================================================================

# [基礎網路與主機設定]
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_HOST=n8n.yourcompany.com
WEBHOOK_URL=https://n8n.yourcompany.com/
GENERIC_TIMEZONE=Asia/Taipei

# [安全性與憑證加密 (極重要：必須隨機生成 32 位以上字串並嚴格保密備份)]
N8N_ENCRYPTION_KEY=CHANGE_THIS_TO_A_RANDOM_LONG_SECRET_KEY_2026_XYZ!
N8N_RUNNERS_ENABLED=true

# [PostgreSQL 資料庫設定]
POSTGRES_USER=n8n_prod_user
POSTGRES_PASSWORD=UltraSecurePostgresPassword2026!
POSTGRES_DB=n8n_enterprise_prod
DB_POSTGRESDB_POOL_SIZE=50

# [Redis 佇列設定 (Queue 模式使用)]
REDIS_PASSWORD=UltraSecureRedisPassword2026!

# [資料生命週期定期清理]
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
EXECUTIONS_DATA_PRUNE_MAX_COUNT=50000
EXECUTIONS_DATA_SAVE_ON_SUCCESS=none
EXECUTIONS_DATA_SAVE_ON_ERROR=all

# [監控與可觀測性]
N8N_METRICS=true
N8N_LOG_LEVEL=info
N8N_LOG_OUTPUT=console
