{
  "name": "01 - 高容錯 ETL 資料清洗管道 (Webhook to DB)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "order-ingestion",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "node-webhook-1",
      "name": "Webhook Ingestion",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "order-ingestion-webhook"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\n  \"status\": \"accepted\",\n  \"message\": \"訂單資料已接收並進入處理管線\",\n  \"receivedAt\": \"{{ $now.toISO() }}\"\n}",
        "options": {}
      },
      "id": "node-respond-1",
      "name": "Respond Immediately",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [460, 200]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map((item, index) => {\n  const raw = item.json.body || item.json;\n  return {\n    json: {\n      orderId: String(raw.order_id || raw.id || 'UNKNOWN'),\n      customerEmail: String(raw.customer_email || raw.email || '').trim().toLowerCase(),\n      totalAmount: parseFloat(raw.total_price || raw.amount || 0),\n      currency: String(raw.currency || 'TWD').toUpperCase(),\n      processedAt: new Date().toISOString()\n    },\n    pairedItem: { item: index }\n  };\n});"
      },
      "id": "node-code-cleanse",
      "name": "Cleanse & Standardize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 400]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-valid-email",
              "leftValue": "={{ $json.customerEmail }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            },
            {
              "id": "cond-valid-amount",
              "leftValue": "={{ $json.totalAmount }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-filter-valid",
      "name": "Filter Valid Orders",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [680, 400]
    },
    {
      "parameters": {
        "batchSize": 50,
        "options": {}
      },
      "id": "node-split-batch",
      "name": "Split In Batches",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [900, 380]
    },
    {
      "parameters": {
        "operation": "upsert",
        "schema": {
          "__rl": true,
          "value": "public",
          "mode": "list"
        },
        "table": {
          "__rl": true,
          "value": "orders",
          "mode": "list"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "order_id": "={{ $json.orderId }}",
            "customer_email": "={{ $json.customerEmail }}",
            "total_amount": "={{ $json.totalAmount }}",
            "currency": "={{ $json.currency }}",
            "updated_at": "={{ $json.processedAt }}"
          }
        },
        "options": {}
      },
      "id": "node-postgres-upsert",
      "name": "Postgres Upsert",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1120, 380]
    }
  ],
  "connections": {
    "Webhook Ingestion": {
      "main": [
        [
          {
            "node": "Respond Immediately",
            "type": "main",
            "index": 0
          },
          {
            "node": "Cleanse & Standardize",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Cleanse & Standardize": {
      "main": [
        [
          {
            "node": "Filter Valid Orders",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter Valid Orders": {
      "main": [
        [
          {
            "node": "Split In Batches",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split In Batches": {
      "main": [
        [
          {
            "node": "Postgres Upsert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Postgres Upsert": {
      "main": [
        [
          {
            "node": "Split In Batches",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
